package com.mycompany.proyectoedaii;

import javax.swing.*;
import java.awt.*;

public class MenuGrafos extends JFrame {

    public MenuGrafos() {
        setTitle("Algoritmos de Grafos");
        setSize(500, 450);
        setLocationRelativeTo(null);
        setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);

        JPanel panel = new JPanel();
        panel.setBackground(new Color(18, 32, 55));
        panel.setLayout(new BoxLayout(panel, BoxLayout.Y_AXIS));

        JLabel titulo = new JLabel("ALGORITMOS DE GRAFOS");
        titulo.setFont(new Font("Arial", Font.BOLD, 23));
        titulo.setForeground(Color.WHITE);
        titulo.setAlignmentX(Component.CENTER_ALIGNMENT);

        String[] algoritmos = {
            "TSM / TSP",
            "PRIM",
            "KAHN",
            "KRUSKAL",
            "DIJKSTRA"
        };

        panel.add(Box.createVerticalStrut(30));
        panel.add(titulo);
        panel.add(Box.createVerticalStrut(30));

        for (String algoritmo : algoritmos) {
            JButton boton = new JButton(algoritmo);
            boton.setFont(new Font("Arial", Font.BOLD, 15));
            boton.setBackground(new Color(30, 130, 220));
            boton.setForeground(Color.WHITE);
            boton.setAlignmentX(Component.CENTER_ALIGNMENT);
            boton.setMaximumSize(new Dimension(280, 40));

            boton.addActionListener(e ->
                JOptionPane.showMessageDialog(this,
                    "El algoritmo " + algoritmo +
                    " será implementado próximamente."));

            panel.add(boton);
            panel.add(Box.createVerticalStrut(12));
        }

        add(panel);
    }
}

