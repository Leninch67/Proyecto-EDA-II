
package com.mycompany.proyectoedaii;

import javax.swing.*;
import java.awt.*;

public class Principal extends JFrame {

    public Principal() {
        setTitle("Proyecto de Bimestre - EDA II");
        setSize(750, 500);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setResizable(false);

        JPanel panel = new JPanel();
        panel.setBackground(new Color(18, 32, 55));
        panel.setLayout(new BoxLayout(panel, BoxLayout.Y_AXIS));

        JLabel universidad = new JLabel("ESCUELA POLITÉCNICA NACIONAL");
        universidad.setFont(new Font("Arial", Font.BOLD, 25));
        universidad.setForeground(Color.WHITE);
        universidad.setAlignmentX(Component.CENTER_ALIGNMENT);

        JLabel titulo = new JLabel("PROYECTO DE BIMESTRE");
        titulo.setFont(new Font("Arial", Font.BOLD, 30));
        titulo.setForeground(new Color(70, 180, 255));
        titulo.setAlignmentX(Component.CENTER_ALIGNMENT);

        JLabel materia = new JLabel("Estructura de Datos y Algoritmos II");
        materia.setFont(new Font("Arial", Font.PLAIN, 20));
        materia.setForeground(Color.WHITE);
        materia.setAlignmentX(Component.CENTER_ALIGNMENT);

        JLabel estudiante = new JLabel("Estudiante: Lenin Angamarca");
        estudiante.setFont(new Font("Arial", Font.PLAIN, 18));
        estudiante.setForeground(Color.WHITE);
        estudiante.setAlignmentX(Component.CENTER_ALIGNMENT);

        JLabel docente = new JLabel("Docente: Ing. Humberto Guaigua");
        docente.setFont(new Font("Arial", Font.PLAIN, 18));
        docente.setForeground(Color.WHITE);
        docente.setAlignmentX(Component.CENTER_ALIGNMENT);

        JButton ingresar = new JButton("INGRESAR AL PROYECTO");
        ingresar.setFont(new Font("Arial", Font.BOLD, 16));
        ingresar.setBackground(new Color(30, 130, 220));
        ingresar.setForeground(Color.WHITE);
        ingresar.setFocusPainted(false);
        ingresar.setAlignmentX(Component.CENTER_ALIGNMENT);

        ingresar.addActionListener(e -> {
            new MenuPrincipal().setVisible(true);
            dispose();
        });

        panel.add(Box.createVerticalStrut(65));
        panel.add(universidad);
        panel.add(Box.createVerticalStrut(45));
        panel.add(titulo);
        panel.add(Box.createVerticalStrut(20));
        panel.add(materia);
        panel.add(Box.createVerticalStrut(35));
        panel.add(estudiante);
        panel.add(Box.createVerticalStrut(15));
        panel.add(docente);
        panel.add(Box.createVerticalStrut(45));
        panel.add(ingresar);

        add(panel);
    }
}

